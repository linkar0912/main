generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum ExecutionStatus {
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

enum ParticipantState {
  COMMENT_MATCHED
  OPENING_SENT
  OPTED_IN
  FOLLOW_REQUIRED
  FOLLOW_VERIFIED
  LINK_SENT
  EXPIRED
  FAILED
}

model User {
  id               String    @id
  email            String    @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  // Bumped to invalidate every outstanding session for this user at once.
  tokenVersion     Int       @default(0)
  createdAt        DateTime  @default(now())

  authTokens       AuthToken[]
}

// Single-use, expiring tokens for password reset and email verification.
// Only the SHA-256 hash of the token is stored; the raw value lives in the link.
model AuthToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // PASSWORD_RESET | EMAIL_VERIFY
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Denylist for individual session revocation ("log out this device").
// Logout-everywhere uses User.tokenVersion instead and does not touch this table.
model RevokedSession {
  sessionId String   @id
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime // when the underlying session would have expired anyway
}

model WorkspaceInvitation {
  id             String    @id
  workspaceId    String
  email          String
  role           String // ADMIN | MEMBER
  tokenHash      String    @unique
  invitedByUserId String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([email])
}

model Workspace {
  id            String                  @id
  name          String
  slug          String                  @unique
  createdAt     DateTime                @default(now())
  members       WorkspaceMember[]
  connections   InstagramConnection[]
  automations   Automation[]
  participants  AutomationParticipant[]
  executions    AutomationExecution[]
  webhookEvents WebhookEvent[]
}

model WorkspaceMember {
  id          String    @id
  workspaceId String
  email       String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model InstagramConnection {
  id                   String           @id
  workspaceId          String
  igUserId             String
  username             String
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(CONNECTED)
  connectedAt          DateTime         @default(now())
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // A workspace may connect several professional accounts; uniqueness is per account.
  @@unique([workspaceId, igUserId])
  @@index([workspaceId, status])
}

model Automation {
  id           String                  @id
  workspaceId  String
  name         String
  status       AutomationStatus        @default(DRAFT)
  version      Int                     @default(1)
  definition   Json
  activatedAt  DateTime?
  boundMediaId String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]
  participants AutomationParticipant[]

  @@index([workspaceId, status])
}

model AutomationParticipant {
  id                       String           @id
  workspaceId              String
  automationId             String
  instagramAccountId       String
  igScopedUserId           String?
  sourceCommentId          String
  sourceMediaId            String
  sourceMediaSnapshot      Json
  matchedKeyword           String?
  state                    ParticipantState @default(COMMENT_MATCHED)
  publicReplyStatus        String           @default("PENDING")
  publicReplyProviderId    String?
  publicReplySentAt        DateTime?
  publicReplyError         String?
  openingStatus            String           @default("PENDING")
  openingProviderId        String?
  openingSentAt            DateTime?
  openingError             String?
  followStatus             Boolean?
  followCheckedAt          DateTime?
  followCheckError         String?
  finalDeliveryStatus      String           @default("PENDING")
  finalProviderId          String?
  finalDeliveredAt         DateTime?
  finalDeliveryError       String?
  deliveryClickedAt        DateTime?
  messagingWindowExpiresAt DateTime?
  recheckCount             Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation               Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId, sourceCommentId])
  @@index([instagramAccountId, igScopedUserId, state])
  @@index([workspaceId, automationId, updatedAt])
  @@index([messagingWindowExpiresAt])
}

model AutomationExecution {
  id                     String          @id
  workspaceId            String
  automationId           String
  externalEventId        String
  dedupeKey              String
  status                 ExecutionStatus
  dispatchStatus         String          @default("CLAIMED")
  dispatchOwner          String?         @unique
  dispatchStartedAt      DateTime?
  dispatchLeaseExpiresAt DateTime?
  reason                 String?
  providerMessageId      String?
  providerRecipientId    String?
  createdAt              DateTime        @default(now())
  workspace              Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation             Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id              String    @id
  workspaceId     String
  providerEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerEventId])
  @@index([workspaceId, receivedAt])
}

model DataDeletionRequest {
  id                String    @id
  confirmationCode  String    @unique
  signedRequestHash String    @unique
  status            String
  requestedAt       DateTime  @default(now())
  completedAt       DateTime?

  @@index([requestedAt])
}
