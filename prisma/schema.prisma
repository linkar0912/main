generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DELETION_PENDING
}

enum PlatformUserStatus {
  ACTIVE
  SUSPENDED
}

enum AdminAuditPhase {
  ATTEMPT
  SUCCESS
  FAILURE
}

enum ExecutionStatus {
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

enum ParticipantState {
  COMMENT_MATCHED
  OPENING_SENT
  OPTED_IN
  FOLLOW_REQUIRED
  FOLLOW_VERIFIED
  LINK_SENT
  EXPIRED
  FAILED
}

// Append-only history of automation state. Every PATCH snapshots the previous
// state, so a workspace can diff and restore any prior version. Activation-time
// fields (status, activatedAt, boundMediaId, priority, instagramAccountId) are
// stored alongside the definition so a `restoreAutomationVersion` round-trip is
// exact - otherwise a campaign restored from a pre-edit snapshot would silently
// lose its next-media binding and (with the publishedAt > activatedAt check)
// re-bind to the next-published post instead of the originally targeted one.
model AutomationVersion {
  id                 String   @id
  automationId       String
  workspaceId        String
  // Monotonically increasing per-automation version number (1 = creation state).
  version            Int
  // Human-friendly snapshot of the automation name at the time of the snapshot.
  name               String
  // Full definition payload (FlowDefinition Json).
  definition         Json
  // Activation-time fields captured at snapshot time. See the table comment for
  // why these are persisted - a restore that drops any of them would break
  // next-media re-binding or alter which events the flow answers.
  status             AutomationStatus @default(DRAFT)
  priority           Int              @default(0)
  activatedAt        DateTime?
  boundMediaId       String?
  instagramAccountId String?
  facebookPageId     String?
  // Who/what produced the snapshot (user id when available; "system" for cron).
  snapshotBy         String?
  // When the snapshot was taken.
  snapshotAt         DateTime @default(now())

  @@unique([automationId, version])
  @@index([automationId, snapshotAt])
}

enum ContactState {
  NONE
  AWAITING_EMAIL
  AWAITING_FIELD
  CAPTURED
}

// Pipeline stage for the mini-CRM. Defaults to NEW for fresh contacts.
enum LeadStatus {
  NEW
  ENGAGED
  QUALIFIED
  CUSTOMER
}

model WorkspaceInvitation {
  id              String    @id
  workspaceId     String
  email           String
  role            String // ADMIN | MEMBER
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([email])
}

model Workspace {
  id                 String                  @id
  name               String
  slug               String                  @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  version            Int                     @default(1)
  // Optional messaging quiet hours (workspace-local time). Null = always-on.
  quietStartHour     Int?
  quietEndHour       Int?
  timezone           String?
  status             WorkspaceStatus         @default(ACTIVE)
  suspendedAt        DateTime?
  suspendedReason    String?
  suspendedByUserId  String?
  deletionScheduledAt DateTime?
  members            WorkspaceMember[]
  connections        InstagramConnection[]
  facebookPages      FacebookPageConnection[]
  automations        Automation[]
  participants       AutomationParticipant[]
  executions         AutomationExecution[]
  webhookEvents      WebhookEvent[]
  contacts           AutomationContact[]
  sequences          AutomationSequence[]
  broadcasts         Broadcast[]
  outboundDeliveries OutboundDelivery[]
  trackedLinks       TrackedLink[]
  entitlement       WorkspaceEntitlement?
  usagePeriods      WorkspaceUsagePeriod[]
  usageReservations WorkspaceUsageReservation[]

  @@index([status, createdAt])
  @@index([updatedAt, id])
}

model PlanDefinition {
  id                       String   @id
  key                      String   @unique
  name                     String
  isActive                 Boolean  @default(true)
  memberLimit              Int?
  automationLimit          Int?
  instagramConnectionLimit Int?
  facebookConnectionLimit  Int?
  sequenceLimit            Int?
  monthlyBroadcastLimit    Int?
  monthlyDeliveryLimit     Int?
  sequencesEnabled         Boolean  @default(false)
  broadcastsEnabled        Boolean  @default(false)
  trackedLinksEnabled      Boolean  @default(false)
  teamEnabled              Boolean  @default(false)
  facebookEnabled          Boolean  @default(false)
  exportsEnabled           Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  workspaceEntitlements    WorkspaceEntitlement[]

  @@index([isActive, key])
}

model WorkspaceEntitlement {
  workspaceId String   @id
  planId      String
  overrides   Json     @default("{}")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        PlanDefinition @relation(fields: [planId], references: [id])

  @@index([planId])
}

model WorkspaceUsagePeriod {
  workspaceId       String
  periodStart       DateTime @db.Date
  deliveriesReserved Int    @default(0)
  broadcastsCreated  Int    @default(0)
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, periodStart])
  @@index([periodStart, workspaceId])
}

model WorkspaceUsageReservation {
  deliveryKey String   @id
  workspaceId String
  periodStart DateTime @db.Date
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, periodStart])
}

model WorkspaceMember {
  id          String    @id
  workspaceId String
  email       String
  role        String
  userId      String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model PlatformUserControl {
  userId               String             @id
  status               PlatformUserStatus @default(ACTIVE)
  suspendedAt          DateTime?
  suspendedReason      String?
  suspendedByUserId    String?
  sessionInvalidBefore DateTime?
  updatedAt            DateTime           @updatedAt

  @@index([status, updatedAt])
}

model InstagramConnection {
  id                   String           @id
  workspaceId          String
  igUserId             String
  username             String
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(CONNECTED)
  connectedAt          DateTime         @default(now())
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One professional account has exactly one owning workspace.
  @@unique([igUserId])
  @@index([workspaceId, status])
}

model Automation {
  id                String                       @id
  workspaceId       String
  // Instagram account (igUserId) this automation is pinned to. Null = the
  // automation answers events from every connected account in the workspace.
  instagramAccountId String?
  // Facebook Page this automation is pinned to. Mutually exclusive with
  // instagramAccountId: an automation pins to exactly one channel.
  facebookPageId     String?
  name              String
  status            AutomationStatus             @default(DRAFT)
  version           Int                          @default(1)
  definition        Json
  activatedAt       DateTime?
  boundMediaId      String?
  // Higher priority automations are evaluated first when multiple flows could
  // match the same event. 0 (default) is fine for the common single-flow setup.
  priority          Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions        AutomationExecution[]
  participants      AutomationParticipant[]
  dailySendCounters AutomationDailySendCounter[]
  facebookReplyRecipients FacebookReplyRecipient[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
}

model AutomationParticipant {
  id                       String           @id
  workspaceId              String
  automationId             String
  instagramAccountId       String
  igScopedUserId           String?
  sourceCommentId          String
  sourceMediaId            String
  sourceMediaSnapshot      Json
  matchedKeyword           String?
  state                    ParticipantState @default(COMMENT_MATCHED)
  publicReplyStatus        String           @default("PENDING")
  publicReplyProviderId    String?
  publicReplySentAt        DateTime?
  publicReplyError         String?
  openingStatus            String           @default("PENDING")
  openingProviderId        String?
  openingSentAt            DateTime?
  openingError             String?
  followStatus             Boolean?
  followCheckedAt          DateTime?
  followCheckError         String?
  finalDeliveryStatus      String           @default("PENDING")
  finalProviderId          String?
  finalDeliveredAt         DateTime?
  finalDeliveryError       String?
  deliveryClickedAt        DateTime?
  // A/B variant label recorded when the campaign opening message went out.
  variantLabel             String?
  messagingWindowExpiresAt DateTime?
  // Set when a teammate takes over the conversation. The runner skips every
  // automated send while `pausedAt` is non-null.
  pausedAt                 DateTime?
  pausedReason             String?
  pausedByUserId           String?
  recheckCount             Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation               Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId, sourceCommentId])
  @@index([instagramAccountId, igScopedUserId, state])
  @@index([workspaceId, automationId, updatedAt])
  @@index([messagingWindowExpiresAt])
  @@index([pausedAt])
}

// Branded short links the workspace can drop into DMs. The destination URL is
// stored untouched; UTM params are appended at click time so a single link
// works across every campaign.
model TrackedLink {
  id                 String   @id
  workspaceId        String
  // The branded path (e.g. "/r/summer-sale"). Unique per workspace.
  slug               String
  // Final URL we redirect to. Validated as http(s) at write time.
  destination        String
  // Optional expiry. Past the deadline the redirect returns 410 Gone.
  expiresAt          DateTime?
  // UTM parameters appended as query strings. Stored separately so a single
  // destination can be re-used across campaigns with different attribution.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  // Optional webhook pinged on every click (used for conversion callbacks).
  conversionUrl      String?
  // Free-form context for the activity inbox. Limited to 240 chars in the API.
  notes              String?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clicks    TrackedLinkClick[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, createdAt])
}

// Per-click analytics. The ip hash is salted + truncated so we can compute
// unique counts without ever storing the raw IP. Country + UA are best-effort
// headers from the redirect request.
model TrackedLinkClick {
  id        String   @id
  linkId    String
  workspaceId String
  // Hashed (sha256(salt + ip), first 16 hex chars). Never the raw IP.
  ipHash    String
  // User-Agent header (truncated to 240 chars). Helps spot bots.
  userAgent String?
  // Cloudflare/Vercel geo header. Optional.
  country   String?
  clickedAt DateTime @default(now())

  link TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
  @@index([workspaceId, clickedAt])
}

// Workspace-wide registry of people who interacted with a connected Instagram account.
// Powers once-only first-contact greetings (first_contact triggers) and stores emails
// captured by DM email-capture flows.
model AutomationContact {
  id                   String               @id
  workspaceId          String
  instagramAccountId   String
  igScopedUserId       String
  email                String?
  state                ContactState         @default(NONE)
  awaitingAutomationId String?
  awaitingSince        DateTime?
  attempts             Int                  @default(0)
  // Manual + automatic labels ("email_captured", "opted_out", "clicked").
  tags                 String[]             @default([])
  // Engagement score bumped by the repository on notable interactions.
  score                Int                  @default(0)
  // Mini-CRM pipeline stage. Auto-defaults to NEW for every fresh contact.
  leadStatus           LeadStatus           @default(NEW)
  // Team member currently responsible for this contact. Null = unassigned.
  assigneeUserId       String?
  // Free-form internal notes. Max 4 000 characters; surface trimmed in the UI.
  notes                String?
  // Automation that first brought this contact into the workspace (source attribution).
  sourceAutomationId   String?
  fields               Json?
  awaitingFields       Json?
  suppressedAt         DateTime?
  lastSeenAt           DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments          SequenceEnrollment[]

  @@unique([workspaceId, instagramAccountId, igScopedUserId])
  @@unique([id, workspaceId])
  @@index([workspaceId, state])
}

// A timed drip campaign: ordered steps, each sent to enrolled contacts after a delay.
model AutomationSequence {
  id                 String               @id
  workspaceId        String
  name               String
  status             String               @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  steps              Json // SequenceStep[]
  sourceAutomationId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments        SequenceEnrollment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

// Per-contact progress through a sequence.
model SequenceEnrollment {
  id               String             @id
  workspaceId      String
  sequenceId       String
  contactId        String
  currentStepIndex Int                @default(0)
  nextSendAt       DateTime?
  state            String             @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  enrolledAt       DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sequence         AutomationSequence @relation(fields: [sequenceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contact          AutomationContact  @relation(fields: [contactId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([state, nextSendAt])
  @@index([contactId])
}

// A one-off DM blast to a segment of the contact registry.
model Broadcast {
  id          String    @id
  workspaceId String
  name        String
  text        String
  segment     String // all_contacts | captured_email
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  skipped     Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AutomationExecution {
  id                     String          @id
  workspaceId            String
  automationId           String
  externalEventId        String
  dedupeKey              String
  status                 ExecutionStatus
  dispatchStatus         String          @default("CLAIMED")
  dispatchOwner          String?         @unique
  dispatchStartedAt      DateTime?
  dispatchLeaseExpiresAt DateTime?
  reason                 String?
  providerMessageId      String?
  providerRecipientId    String?
  createdAt              DateTime        @default(now())
  workspace              Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation             Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

model OutboundDelivery {
  id                   String    @id
  deliveryKey          String    @unique
  workspaceId          String
  kind                 String
  recipientId          String?
  instagramAccountId   String?
  automationId         String?
  participantId        String?
  sequenceEnrollmentId String?
  broadcastId          String?
  payload              Json
  state                String    @default("PENDING")
  retryable            Boolean   @default(false)
  resultCode           String?
  claimOwner           String?
  claimExpiresAt       DateTime?
  attemptCount         Int       @default(0)
  providerMessageId    String?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sentAt               DateTime?
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([state, claimExpiresAt])
  @@index([workspaceId, kind, createdAt])
  @@index([broadcastId, state])
}

model AutomationDailySendCounter {
  automationId String
  utcDate      DateTime   @db.Date
  reserved     Int        @default(0)
  updatedAt    DateTime   @updatedAt
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@id([automationId, utcDate])
}

model WebhookEvent {
  id              String    @id
  workspaceId     String
  providerEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerEventId])
  @@index([workspaceId, receivedAt])
}

// A Facebook Page connected to a workspace for comment-reply automation.
// Parallel to InstagramConnection - never the two are bridged; an automation
// pins to either one. Page access tokens are stored encrypted, exactly like
// Instagram access tokens.
model FacebookPageConnection {
  id                   String           @id
  workspaceId          String
  pageId               String
  pageName             String
  facebookUserId       String?
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(CONNECTED)
  connectedAt          DateTime         @default(now())
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One Facebook Page has exactly one owning workspace.
  @@unique([pageId])
  @@index([workspaceId, status])
  @@index([facebookUserId])
}

model FacebookReplyRecipient {
  id             String     @id
  automationId   String
  pageId         String
  senderId       String
  claimEventId   String
  claimExpiresAt DateTime
  repliedAt      DateTime?
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, pageId, senderId])
  @@index([claimExpiresAt])
}

model DataDeletionRequest {
  id                String    @id
  confirmationCode  String    @unique
  signedRequestHash String    @unique
  status            String
  requestedAt       DateTime  @default(now())
  completedAt       DateTime?

  @@index([requestedAt])
}

model AdminAuditEvent {
  id          String          @id
  requestId   String
  phase       AdminAuditPhase
  actorUserId String
  actorEmail  String
  sessionId   String
  action      String
  targetType  String
  targetId    String
  workspaceId String?
  reason      String
  before      Json?
  after       Json?
  errorCode   String?
  ipHash      String
  userAgent   String
  origin      String?
  createdAt   DateTime        @default(now())

  @@unique([requestId, phase])
  @@index([createdAt, id])
  @@index([workspaceId, createdAt])
}
