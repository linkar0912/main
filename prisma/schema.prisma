generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
}

enum ExecutionStatus {
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

enum ParticipantState {
  COMMENT_MATCHED
  OPENING_SENT
  OPTED_IN
  FOLLOW_REQUIRED
  FOLLOW_VERIFIED
  LINK_SENT
  EXPIRED
  FAILED
}

// Append-only history of automation definitions. Every PATCH snapshots the
// previous state, so a workspace can diff and restore any prior version.
model AutomationVersion {
  id            String   @id
  automationId  String
  workspaceId   String
  // Monotonically increasing per-automation version number (1 = creation state).
  version       Int
  // Human-friendly snapshot of the automation name at the time of the snapshot.
  name          String
  // Full definition payload (FlowDefinition Json).
  definition    Json
  // Who/what produced the snapshot (user id when available; "system" for cron).
  snapshotBy    String?
  // When the snapshot was taken.
  snapshotAt    DateTime @default(now())

  @@unique([automationId, version])
  @@index([automationId, snapshotAt])
}

enum ContactState {
  NONE
  AWAITING_EMAIL
  AWAITING_FIELD
  CAPTURED
}

// Pipeline stage for the mini-CRM. Defaults to NEW for fresh contacts.
enum LeadStatus {
  NEW
  ENGAGED
  QUALIFIED
  CUSTOMER
}

model User {
  id              String    @id
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  // Bumped to invalidate every outstanding session for this user at once.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())

  authTokens AuthToken[]
}

// Single-use, expiring tokens for password reset and email verification.
// Only the SHA-256 hash of the token is stored; the raw value lives in the link.
model AuthToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // PASSWORD_RESET | EMAIL_VERIFY
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Denylist for individual session revocation ("log out this device").
// Logout-everywhere uses User.tokenVersion instead and does not touch this table.
model RevokedSession {
  sessionId String   @id
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime // when the underlying session would have expired anyway
}

model WorkspaceInvitation {
  id              String    @id
  workspaceId     String
  email           String
  role            String // ADMIN | MEMBER
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([email])
}

model Workspace {
  id                 String                  @id
  name               String
  slug               String                  @unique
  createdAt          DateTime                @default(now())
  // Optional messaging quiet hours (workspace-local time). Null = always-on.
  quietStartHour     Int?
  quietEndHour       Int?
  timezone           String?
  members            WorkspaceMember[]
  connections        InstagramConnection[]
  automations        Automation[]
  participants       AutomationParticipant[]
  executions         AutomationExecution[]
  webhookEvents      WebhookEvent[]
  contacts           AutomationContact[]
  sequences          AutomationSequence[]
  broadcasts         Broadcast[]
  outboundDeliveries OutboundDelivery[]
  trackedLinks       TrackedLink[]
}

model WorkspaceMember {
  id          String    @id
  workspaceId String
  email       String
  role        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model InstagramConnection {
  id                   String           @id
  workspaceId          String
  igUserId             String
  username             String
  accessTokenEncrypted String
  tokenExpiresAt       DateTime?
  status               ConnectionStatus @default(CONNECTED)
  connectedAt          DateTime         @default(now())
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One professional account has exactly one owning workspace.
  @@unique([igUserId])
  @@index([workspaceId, status])
}

model Automation {
  id                String                       @id
  workspaceId       String
  // Instagram account (igUserId) this automation is pinned to. Null = the
  // automation answers events from every connected account in the workspace.
  instagramAccountId String?
  name              String
  status            AutomationStatus             @default(DRAFT)
  version           Int                          @default(1)
  definition        Json
  activatedAt       DateTime?
  boundMediaId      String?
  // Higher priority automations are evaluated first when multiple flows could
  // match the same event. 0 (default) is fine for the common single-flow setup.
  priority          Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions        AutomationExecution[]
  participants      AutomationParticipant[]
  dailySendCounters AutomationDailySendCounter[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
}

model AutomationParticipant {
  id                       String           @id
  workspaceId              String
  automationId             String
  instagramAccountId       String
  igScopedUserId           String?
  sourceCommentId          String
  sourceMediaId            String
  sourceMediaSnapshot      Json
  matchedKeyword           String?
  state                    ParticipantState @default(COMMENT_MATCHED)
  publicReplyStatus        String           @default("PENDING")
  publicReplyProviderId    String?
  publicReplySentAt        DateTime?
  publicReplyError         String?
  openingStatus            String           @default("PENDING")
  openingProviderId        String?
  openingSentAt            DateTime?
  openingError             String?
  followStatus             Boolean?
  followCheckedAt          DateTime?
  followCheckError         String?
  finalDeliveryStatus      String           @default("PENDING")
  finalProviderId          String?
  finalDeliveredAt         DateTime?
  finalDeliveryError       String?
  deliveryClickedAt        DateTime?
  // A/B variant label recorded when the campaign opening message went out.
  variantLabel             String?
  messagingWindowExpiresAt DateTime?
  // Set when a teammate takes over the conversation. The runner skips every
  // automated send while `pausedAt` is non-null.
  pausedAt                 DateTime?
  pausedReason             String?
  pausedByUserId           String?
  recheckCount             Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation               Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, instagramAccountId, sourceCommentId])
  @@index([instagramAccountId, igScopedUserId, state])
  @@index([workspaceId, automationId, updatedAt])
  @@index([messagingWindowExpiresAt])
  @@index([pausedAt])
}

// Branded short links the workspace can drop into DMs. The destination URL is
// stored untouched; UTM params are appended at click time so a single link
// works across every campaign.
model TrackedLink {
  id                 String   @id
  workspaceId        String
  // The branded path (e.g. "/r/summer-sale"). Unique per workspace.
  slug               String
  // Final URL we redirect to. Validated as http(s) at write time.
  destination        String
  // Optional expiry. Past the deadline the redirect returns 410 Gone.
  expiresAt          DateTime?
  // UTM parameters appended as query strings. Stored separately so a single
  // destination can be re-used across campaigns with different attribution.
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  // Optional webhook pinged on every click (used for conversion callbacks).
  conversionUrl      String?
  // Free-form context for the activity inbox. Limited to 240 chars in the API.
  notes              String?
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clicks    TrackedLinkClick[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, createdAt])
}

// Per-click analytics. The ip hash is salted + truncated so we can compute
// unique counts without ever storing the raw IP. Country + UA are best-effort
// headers from the redirect request.
model TrackedLinkClick {
  id        String   @id
  linkId    String
  workspaceId String
  // Hashed (sha256(salt + ip), first 16 hex chars). Never the raw IP.
  ipHash    String
  // User-Agent header (truncated to 240 chars). Helps spot bots.
  userAgent String?
  // Cloudflare/Vercel geo header. Optional.
  country   String?
  clickedAt DateTime @default(now())

  link TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
  @@index([workspaceId, clickedAt])
}

// Workspace-wide registry of people who interacted with a connected Instagram account.
// Powers once-only first-contact greetings (first_contact triggers) and stores emails
// captured by DM email-capture flows.
model AutomationContact {
  id                   String               @id
  workspaceId          String
  instagramAccountId   String
  igScopedUserId       String
  email                String?
  state                ContactState         @default(NONE)
  awaitingAutomationId String?
  awaitingSince        DateTime?
  attempts             Int                  @default(0)
  // Manual + automatic labels ("email_captured", "opted_out", "clicked").
  tags                 String[]             @default([])
  // Engagement score bumped by the repository on notable interactions.
  score                Int                  @default(0)
  // Mini-CRM pipeline stage. Auto-defaults to NEW for every fresh contact.
  leadStatus           LeadStatus           @default(NEW)
  // Team member currently responsible for this contact. Null = unassigned.
  assigneeUserId       String?
  // Free-form internal notes. Max 4 000 characters; surface trimmed in the UI.
  notes                String?
  // Automation that first brought this contact into the workspace (source attribution).
  sourceAutomationId   String?
  fields               Json?
  awaitingFields       Json?
  suppressedAt         DateTime?
  lastSeenAt           DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments          SequenceEnrollment[]

  @@unique([workspaceId, instagramAccountId, igScopedUserId])
  @@unique([id, workspaceId])
  @@index([workspaceId, state])
}

// A timed drip campaign: ordered steps, each sent to enrolled contacts after a delay.
model AutomationSequence {
  id                 String               @id
  workspaceId        String
  name               String
  status             String               @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  steps              Json // SequenceStep[]
  sourceAutomationId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments        SequenceEnrollment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}

// Per-contact progress through a sequence.
model SequenceEnrollment {
  id               String             @id
  workspaceId      String
  sequenceId       String
  contactId        String
  currentStepIndex Int                @default(0)
  nextSendAt       DateTime?
  state            String             @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  enrolledAt       DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  sequence         AutomationSequence @relation(fields: [sequenceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contact          AutomationContact  @relation(fields: [contactId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([sequenceId, contactId])
  @@index([state, nextSendAt])
  @@index([contactId])
}

// A one-off DM blast to a segment of the contact registry.
model Broadcast {
  id          String    @id
  workspaceId String
  name        String
  text        String
  segment     String // all_contacts | captured_email
  status      String    @default("PENDING") // PENDING | RUNNING | COMPLETED
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  skipped     Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AutomationExecution {
  id                     String          @id
  workspaceId            String
  automationId           String
  externalEventId        String
  dedupeKey              String
  status                 ExecutionStatus
  dispatchStatus         String          @default("CLAIMED")
  dispatchOwner          String?         @unique
  dispatchStartedAt      DateTime?
  dispatchLeaseExpiresAt DateTime?
  reason                 String?
  providerMessageId      String?
  providerRecipientId    String?
  createdAt              DateTime        @default(now())
  workspace              Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation             Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

model OutboundDelivery {
  id                   String    @id
  deliveryKey          String    @unique
  workspaceId          String
  kind                 String
  recipientId          String?
  instagramAccountId   String?
  automationId         String?
  participantId        String?
  sequenceEnrollmentId String?
  broadcastId          String?
  payload              Json
  state                String    @default("PENDING")
  retryable            Boolean   @default(false)
  resultCode           String?
  claimOwner           String?
  claimExpiresAt       DateTime?
  attemptCount         Int       @default(0)
  providerMessageId    String?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sentAt               DateTime?
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([state, claimExpiresAt])
  @@index([workspaceId, kind, createdAt])
  @@index([broadcastId, state])
}

model AutomationDailySendCounter {
  automationId String
  utcDate      DateTime   @db.Date
  reserved     Int        @default(0)
  updatedAt    DateTime   @updatedAt
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@id([automationId, utcDate])
}

model WebhookEvent {
  id              String    @id
  workspaceId     String
  providerEventId String
  eventType       String
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerEventId])
  @@index([workspaceId, receivedAt])
}

model DataDeletionRequest {
  id                String    @id
  confirmationCode  String    @unique
  signedRequestHash String    @unique
  status            String
  requestedAt       DateTime  @default(now())
  completedAt       DateTime?

  @@index([requestedAt])
}
