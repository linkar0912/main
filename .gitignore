# Ad-hoc backups of local env files (.env.local.bak-*, .env.bak, ...). The
# existing patterns above only match names ending in .local/.production, so a
# file like ".env.local.bak-before-prod-preview" was tracked as untracked-but-
# committable and held live app secrets.
.env*.bak*
.env.*.bak*
*.env.bak
