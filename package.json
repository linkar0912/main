{
  "name": "linkar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "check:copy": "node scripts/check-customer-copy.mjs",
    "check:css-budget": "node scripts/check-css-budget.mjs",
    "check:deployment-hygiene": "node scripts/check-deployment-hygiene.mjs",
    "check:regex-keywords": "tsx scripts/check-regex-keywords.ts",
    "css:public": "node scripts/build-public-css.mjs",
    "preflight:billing": "node scripts/verify-billing-config.mjs",
    "preflight:instagram-ownership": "node scripts/preflight-instagram-ownership.mjs",
    "monitor:production": "node scripts/check-production-health.mjs",
    "monitor:oauth": "node scripts/check-oauth-redirects.mjs",
    "backfill:member-user-ids": "node scripts/backfill-member-user-ids.mjs",
    "backfill:contact-last-inbound": "node scripts/backfill-contact-last-inbound.mjs",
    "backfill:webhook-event-actors": "node scripts/backfill-webhook-event-actors.mjs",
    "preview:synthetic-accounts": "tsx scripts/preview-synthetic-accounts.ts",
    "dev": "next dev",
    "build": "prisma generate && next build && pnpm build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/worker.js --alias:server-only=./scripts/server-only-worker-shim.mjs --external:@prisma/client --external:bullmq --external:ioredis --define:process.env.LINKAR_PROCESS_ROLE='\"worker\"'",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "LINKAR_PROCESS_ROLE=worker tsx src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node scripts/migrate-deploy.mjs",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "bullmq": "6.5.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
