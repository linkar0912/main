{
  "name": "linkar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "check:branding": "node scripts/check-branding.mjs",
    "check:copy": "node scripts/check-customer-copy.mjs",
    "check:compose": "docker compose --env-file .env.production.example -f docker-compose.production.yml config --quiet",
    "preflight:billing": "node scripts/verify-billing-config.mjs",
    "preflight:instagram-ownership": "node scripts/preflight-instagram-ownership.mjs",
    "monitor:production": "node scripts/check-production-health.mjs",
    "backfill:member-user-ids": "node scripts/backfill-member-user-ids.mjs",
    "preview:synthetic-accounts": "tsx scripts/preview-synthetic-accounts.ts",
    "deploy:coolify": "node scripts/coolify-deploy.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build && pnpm build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/worker.js --alias:server-only=./scripts/server-only-worker-shim.mjs --external:@prisma/client --external:bullmq --external:ioredis",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "worker": "tsx src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "bullmq": "6.1.2",
    "ioredis": "6.0.0",
    "jose": "^6.2.10",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tsx": "4.23.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
