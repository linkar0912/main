# Production variable-name checklist. Enter values as Dokploy configuration or
# secrets, replace every `replace-with-*` placeholder, and never commit a
# populated production environment file. Both linkar-web and linkar-worker
# refuse to boot while a placeholder is left in, or while DATABASE_URL,
# REDIS_URL, the Supabase URL/keys, or META_TOKEN_ENCRYPTION_KEY are missing.
APP_NAME=Linkar
APP_URL=https://app.linkar.in
NEXT_PUBLIC_APP_URL=https://app.linkar.in
ADMIN_URL=https://admin.linkar.in
PUBLIC_SITE_URL=https://linkar.in
SUPPORT_EMAIL=support@linkar.in

# Server-side signing key (min 32 characters). Sessions themselves are
# Supabase Auth's; this key signs the OAuth `state` for Instagram, Facebook and
# Google sign-in, the owner console's audit/list cursors and request ids, and
# the HMAC behind login/signup/billing rate-limit keys. Rotating it fails any
# OAuth connection that is mid-flow and resets rate-limit buckets - rotate in a
# quiet window and redeploy web and worker together.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Exact Supabase Auth UUID allowlist for the Linkar platform owner console.
PLATFORM_OWNER_USER_IDS=replace-with-supabase-owner-user-uuid

# Optional: Resend API key (the only supported provider) for team invitations
# and platform admin alerts to PLATFORM_ALERT_EMAILS. Signup verification and
# password-reset mail is sent by Supabase Auth (configure its SMTP in the
# Supabase dashboard), not through this key. Without it invitations and alerts
# are not sent; the server logs only that a message was skipped and its
# subject, never the body or its links.
EMAIL_API_KEY=
EMAIL_FROM=Linkar Alerts <alerts@linkar.in>
PLATFORM_ALERT_EMAILS=replace-with-platform-owner-email

# Supabase project (Postgres + Auth). DATABASE_URL is the transaction pooler
# (port 6543, ?pgbouncer=true required); a separate DIRECT_URL (port 5432, no
# pgbouncer) is used only by `prisma migrate deploy`, which needs an advisory
# lock the transaction pooler does not support. connection_limit sizes Prisma's
# pool per process (its default is only 2 x CPUs + 1); see WORKER_CONCURRENCY.
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20
DIRECT_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# NEXT_PUBLIC_* values are inlined into the browser bundle at image build
# time; server code reads SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY first when
# they are set, so the runtime values in Dokploy win on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Dedicated Linkar Valkey service on the internal compose network.
VALKEY_PASSWORD=replace-with-a-unique-valkey-password
REDIS_URL=redis://:replace-with-a-unique-valkey-password@valkey:6379/0
# The web application probes the worker over the private Linkar network.
WORKER_HEALTH_URL=http://worker:3001/health

# Meta Business Login for Instagram. The owner obtains these values from Meta.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-token-encryption-key
META_REDIRECT_URI=https://app.linkar.in/api/meta/oauth/callback
# Webhook verify tokens: at least 32 random characters (enforced at boot when
# the channel's app id is set), and identical to the value in the Meta app.
META_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# Facebook Login for Business (Pages). Optional. Owners who also want Page
# automation create a second Meta app ("Facebook Login for Business" product)
# and complete Meta App Review for the scopes below. The page access tokens
# are encrypted with META_TOKEN_ENCRYPTION_KEY by default; set
# FACEBOOK_TOKEN_ENCRYPTION_KEY to a 64-hex-char string to use a dedicated
# key.
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret
FACEBOOK_REDIRECT_URI=https://app.linkar.in/api/facebook/oauth/callback
FACEBOOK_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token
FACEBOOK_API_VERSION=v25.0
FACEBOOK_SCOPES=pages_show_list,pages_manage_engagement,pages_manage_metadata,pages_read_engagement,pages_read_user_content
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Google sign-in. Optional - leave blank to hide the Google button on
# login/signup. Talks to Google directly (not through Supabase's hosted OAuth
# relay) so the consent screen shows app.linkar.in instead of the Supabase
# project's domain; the resulting ID token still goes through Supabase
# (signInWithIdToken) to create the session. Register this redirect URI in
# Google Cloud Console alongside the Supabase one Supabase's own dashboard
# shows you - both must stay registered.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.linkar.in/api/auth/oauth/google/callback

# Razorpay Subscriptions. Enter these as Dokploy secrets/configuration; never
# expose the key secret or webhook secret through NEXT_PUBLIC_* variables.
RAZORPAY_KEY_ID=replace-with-razorpay-live-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-live-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-random-webhook-secret
RAZORPAY_PLAN_CREATOR_MONTHLY_ID=plan_replace_with_creator_monthly
RAZORPAY_PLAN_CREATOR_ANNUAL_ID=plan_replace_with_creator_annual
RAZORPAY_PLAN_GROWTH_MONTHLY_ID=plan_replace_with_growth_monthly
RAZORPAY_PLAN_GROWTH_ANNUAL_ID=plan_replace_with_growth_annual
RAZORPAY_PLAN_AGENCY_MONTHLY_ID=plan_replace_with_agency_monthly
RAZORPAY_PLAN_AGENCY_ANNUAL_ID=plan_replace_with_agency_annual

# Gates version 2 (follow-gated Reel campaign) execution only; automation
# creation, preview, and version 1 execution work regardless of this value.
# App Review has been submitted. Keep this identical on linkar-web and
# linkar-worker; the public health response exposes the safe enabled/disabled
# state so rollout drift is visible after deploy.
# See ops/DOKPLOY_DEPLOYMENT.md.
FOLLOW_GATED_CAMPAIGNS_ENABLED=true

# Outbound provider calls abort after this deadline. Keep the dispatch lease at
# least 5000 ms longer so a claim cannot expire while its request is in flight.
PROVIDER_REQUEST_TIMEOUT_MS=10000
DISPATCH_LEASE_MS=30000

# Meta caps private replies to comments on posts/Reels at 750 calls/hour per
# Instagram professional account (confirmed against Meta's Business Messaging
# docs, Sept 2026 - Meta revises these, re-verify before raising this). Scoped
# per connected account automatically, not per app. Set to 0 to disable.
PRIVATE_REPLY_RATE_LIMIT_PER_HOUR=750

# Per-account ceilings for the other two send paths: DMs (broadcasts, sequences,
# flow follow-ups, campaign final delivery) and public comment replies. Unlike
# the private-reply number above, these are NOT documented Meta figures - Meta
# throttles Instagram messaging and Pages dynamically off account engagement and
# publishes no per-account hourly limit. They default deliberately low so a
# burst stays well under whatever the real ceiling is; raise them only if you
# have measured headroom for your accounts. Set to 0 to disable.
DIRECT_MESSAGE_RATE_LIMIT_PER_HOUR=250
COMMENT_REPLY_RATE_LIMIT_PER_HOUR=250

# Google Analytics 4 measurement ID. Read at request time by the root layout,
# so changing it needs a restart but not a rebuild.
GA_MEASUREMENT_ID=G-CLMXQ4YFD1

# --- Operations tuning -------------------------------------------------------
# All optional; the values below are the code defaults. Keep the worker-related
# values identical on linkar-web and linkar-worker where both read them.

# Client-IP resolution for login, signup and billing rate limits
# (src/lib/auth/client-address.ts). 0 ignores both cf-connecting-ip and
# X-Forwarded-For, so every visitor shares one "unknown" bucket and a single
# attacker can lock everyone out. Any value above 0 trusts cf-connecting-ip,
# which Cloudflare sets on every proxied request - so the origin MUST accept
# connections only from Cloudflare (firewall the host's 80/443 to Cloudflare's
# published IP ranges, or use a Cloudflare Tunnel / authenticated origin
# pulls); otherwise a direct connection can forge the header.
#
# The value is the number of right-most X-Forwarded-For entries to discard
# (the addresses trusted proxies appended). Behind Cloudflare -> Traefik ->
# app, Cloudflare appends the visitor's IP and Traefik appends Cloudflare's
# edge IP, so the app sees "visitor, cloudflare-edge": discard 1. Do not use 2
# (the two proxies) - that would read the entry *before* the visitor's, which
# the visitor controls. The XFF path is only a fallback; cf-connecting-ip wins
# whenever it is present. (If Traefik is not configured to trust Cloudflare's
# forwarded headers it replaces X-Forwarded-For with the edge IP, the fallback
# yields "unknown", and cf-connecting-ip alone identifies visitors.)
TRUSTED_PROXY_HOPS=1

# BullMQ jobs the singleton worker runs in parallel. Each realtime job spends
# most of its time waiting on Meta and the database, so a viral post with
# hundreds of comments drains far faster at 15 than at 5; per-account Meta send
# limits are enforced separately. Keep DATABASE_URL's connection_limit at or
# above this value so jobs don't queue for a pooled connection.
WORKER_CONCURRENCY=15

# Port the worker's private health endpoint listens on (never publish it). The
# owner console reads it through WORKER_HEALTH_URL above.
WORKER_HEALTH_PORT=3001

# Owner-console step-up challenge lifetime, in seconds.
ADMIN_CHALLENGE_TTL_SECONDS=600

# Account deletion jobs: attempts before a job fails, and the base backoff in ms.
DELETION_JOB_ATTEMPTS=8
DELETION_JOB_BACKOFF_MS=5000

# debug | info | warn | error
LOG_LEVEL=info

# Shared secret for the detailed /api/health view, sent as the x-health-token
# header (linkar-web only). Without it anonymous callers - and the release
# tooling - see only {"status": ...}. Store the same value as the
# HEALTH_DETAIL_TOKEN GitHub secret and in /etc/dokploy-release/linkar-health-token.
HEALTH_DETAIL_TOKEN=replace-with-at-least-32-random-characters

# Never set DEMO_MODE in production: it lets the app boot without its
# database, Redis, Supabase and token key and serve sample data.

# Do NOT set BUILD_COMMIT in Dokploy. It is baked into the image by the release
# workflow (see the Dockerfile) so /api/health reports the deployed commit.
# PRODUCTION_HEALTH_URL and EXPECTED_RELEASE are only read by
# `pnpm monitor:production` and the GitHub workflows; they are not runtime
# settings.
