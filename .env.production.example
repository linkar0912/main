# Copy this file to .env.production for the local production compose topology.
# In Coolify, enter these as server-side variables/secrets instead. Replace all
# `replace-with-*` values; never commit .env.production. `pnpm check:compose`
# validates this complete template, while production Compose requires every
# secret and deployment value to be explicitly supplied.
APP_NAME=Linkar
NEXT_PUBLIC_APP_URL=https://linkar.in
SUPPORT_EMAIL=owner-provided@example.com
SOURCE_COMMIT=set-by-coolify-or-ci

# Signs session cookies (min 32 characters). The workspace owner signs up at
# /signup on first run; teammates are invited from Settings > Team.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: transactional email provider key (Resend/SES) for signup
# verification, invitations, and password-reset mail. Without it, that mail is
# written to the server log instead of being delivered.
EMAIL_API_KEY=

# Plan ceiling: new automation participants served per workspace per month.

# Supabase project (Postgres + Auth). DATABASE_URL is the transaction pooler
# (port 6543, ?pgbouncer=true required); a separate DIRECT_URL (port 5432, no
# pgbouncer) is used only by `prisma migrate deploy`, which needs an advisory
# lock the transaction pooler does not support.
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:replace-with-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Dedicated Linkar Valkey service on the internal compose network.
VALKEY_PASSWORD=replace-with-a-unique-valkey-password
REDIS_URL=redis://:replace-with-a-unique-valkey-password@valkey:6379/0

# Meta Business Login for Instagram. The owner obtains these values from Meta.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-token-encryption-key
META_REDIRECT_URI=https://linkar.in/api/meta/oauth/callback
META_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# Gates version 2 (follow-gated Reel campaign) execution only; automation
# creation, preview, and version 1 execution work regardless of this value.
# Deploy as false, verify the tester connection and webhook subscription
# fields, then set true on both linkar-web and linkar-worker.
# See ops/COOLIFY_DEPLOYMENT.md.
FOLLOW_GATED_CAMPAIGNS_ENABLED=false
