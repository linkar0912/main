# Copy this file to .env.production for the local production compose topology.
# In Coolify, enter these as server-side variables/secrets instead. Replace all
# `replace-with-*` values; never commit .env.production. `pnpm check:compose`
# validates this complete template, while production Compose requires every
# secret and deployment value to be explicitly supplied.
APP_NAME=ReplyConnect
NEXT_PUBLIC_APP_URL=https://replyconnect.example.com
SUPPORT_EMAIL=owner-provided@example.com
SOURCE_COMMIT=set-by-coolify-or-ci

# Dedicated ReplyConnect PostgreSQL database on the internal compose network.
POSTGRES_DB=replyconnect
POSTGRES_USER=replyconnect
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
DATABASE_URL=postgresql://replyconnect:replace-with-a-unique-postgres-password@postgres:5432/replyconnect?schema=public

# Dedicated ReplyConnect Valkey service on the internal compose network.
VALKEY_PASSWORD=replace-with-a-unique-valkey-password
REDIS_URL=redis://:replace-with-a-unique-valkey-password@valkey:6379/0

# Meta Business Login for Instagram. The owner obtains these values from Meta.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
META_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-token-encryption-key
META_REDIRECT_URI=https://replyconnect.example.com/api/meta/oauth/callback
META_VERIFY_TOKEN=replace-with-a-long-random-webhook-verify-token
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
