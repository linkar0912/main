APP_NAME=ReplyConnect
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@replyconnect.in

# Required in production: signs session cookies (min 32 chars).
# Generate with a password manager or `openssl rand -hex 32`.
AUTH_SESSION_SECRET=

# Optional: transactional email provider key (Resend/SES) for signup
# verification and password-reset mail. Without it, that mail is written to
# the server log instead of being delivered.
EMAIL_API_KEY=

# Plan ceiling: new automation participants served per workspace per month.
PLAN_MONTHLY_PARTICIPANT_LIMIT=500

# Omit DATABASE_URL and REDIS_URL for local demo mode.
DATABASE_URL=postgresql://replyconnect:replyconnect@localhost:5432/replyconnect?schema=public
REDIS_URL=redis://localhost:6379

# Meta Business Login for Instagram
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_VERIFY_TOKEN=change-me
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
FOLLOW_GATED_CAMPAIGNS_ENABLED=false

# Operations tuning (sensible defaults; see README for proxy/worker guidance)
# Number of trusted reverse proxies in front of the app, used to resolve the real
# client IP from X-Forwarded-For for login rate limiting.
TRUSTED_PROXY_HOPS=0
WORKER_CONCURRENCY=5
DISPATCH_LEASE_MS=30000
LOG_LEVEL=info
