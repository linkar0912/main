APP_NAME=Linkar
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@linkar.in

# Server-side signing key (required in production, min 32 chars, no
# placeholder). It signs the OAuth `state` for Instagram, Facebook and Google
# sign-in, the owner console's audit/list cursors and request ids, and the
# HMAC that turns client IPs and emails into rate-limit keys. Rotating it
# breaks OAuth flows that are in flight and outstanding console cursors, and
# resets rate-limit buckets. Generate with `openssl rand -hex 32`.
AUTH_SESSION_SECRET=

# Server-only Supabase Auth user UUIDs allowed into the Linkar owner console.
# Never use email addresses or expose this through a NEXT_PUBLIC_* variable.
PLATFORM_OWNER_USER_IDS=

# Production domains: APP_URL/NEXT_PUBLIC_APP_URL=https://app.linkar.in,
# ADMIN_URL=https://admin.linkar.in, and PUBLIC_SITE_URL=https://linkar.in.
# OAuth callbacks remain on app.linkar.in.

# Optional: Resend API key (the only supported provider) for team invitations
# and platform admin alerts to PLATFORM_ALERT_EMAILS. Signup confirmation and
# password-reset mail is sent by Supabase Auth, not through this key. Without
# it that mail is not sent at all: the server logs only that a message was
# skipped and its subject - never the body or its links.
EMAIL_API_KEY=
EMAIL_FROM=Linkar Alerts <alerts@linkar.in>
PLATFORM_ALERT_EMAILS=

# Omit DATABASE_URL and REDIS_URL for local demo mode. The values below match
# docker-compose.yml. DIRECT_URL is the non-pooled connection used only by
# `pnpm db:migrate:deploy`; locally it is the same database.
DATABASE_URL=postgresql://linkar:linkar@localhost:5432/linkar?schema=public
DIRECT_URL=postgresql://linkar:linkar@localhost:5432/linkar?schema=public
REDIS_URL=redis://:linkar-local-redis@localhost:6379/0

# Supabase project (Auth) - required for signup and login, even in local demo
# mode. Either a hosted project (Project Settings > API) or the local stack
# from `supabase start` (supabase/config.toml; `supabase status` prints the
# values). The service-role key is used by the owner console and account
# deletion. Server code prefers SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY when
# set (read at runtime); the browser always uses the NEXT_PUBLIC_* copies,
# which are inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Not read by Linkar: SUPABASE_DATABASE_URL and SUPABASE_DIRECT_URL. Prisma
# uses DATABASE_URL and DIRECT_URL above; remove the SUPABASE_* copies from
# old local env files.

# Meta Business Login for Instagram
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_VERIFY_TOKEN=change-me
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# Facebook Login for Business (Pages). Optional - leave blank to hide the
# Facebook section in Settings. The Page access tokens are encrypted with
# META_TOKEN_ENCRYPTION_KEY by default; set FACEBOOK_TOKEN_ENCRYPTION_KEY to
# a 64-hex-char string to use a dedicated key.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/oauth/callback
FACEBOOK_VERIFY_TOKEN=change-me
FACEBOOK_API_VERSION=v25.0
FACEBOOK_SCOPES=pages_show_list,pages_manage_engagement,pages_manage_metadata,pages_read_engagement,pages_read_user_content
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Google sign-in. Optional - leave blank to hide the Google button on
# login/signup. Talks to Google directly (not through Supabase's hosted OAuth
# relay) so the consent screen shows this app's own domain instead of the
# Supabase project's; the resulting ID token still goes through Supabase
# (signInWithIdToken) to create the session.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Razorpay Subscriptions. Keep secrets server-only. Use test-mode values for
# local development and a separate live webhook secret in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR_MONTHLY_ID=
RAZORPAY_PLAN_CREATOR_ANNUAL_ID=
RAZORPAY_PLAN_GROWTH_MONTHLY_ID=
RAZORPAY_PLAN_GROWTH_ANNUAL_ID=
RAZORPAY_PLAN_AGENCY_MONTHLY_ID=
RAZORPAY_PLAN_AGENCY_ANNUAL_ID=

FOLLOW_GATED_CAMPAIGNS_ENABLED=false

# Operations tuning (sensible defaults; see README for proxy/worker guidance)
# Number of trusted reverse proxies in front of the app, used to resolve the real
# client IP from X-Forwarded-For for login rate limiting. 0 locally; see
# .env.production.example for the Cloudflare + Traefik value.
TRUSTED_PROXY_HOPS=0
WORKER_CONCURRENCY=15
# Worker heartbeat endpoint for the owner console. Production uses the private
# container URL http://worker:3001/health; an HTTPS URL is also accepted
# when the worker is exposed through a secured internal gateway.
WORKER_HEALTH_URL=
PROVIDER_REQUEST_TIMEOUT_MS=10000
DISPATCH_LEASE_MS=30000
ADMIN_CHALLENGE_TTL_SECONDS=600
DELETION_JOB_ATTEMPTS=8
DELETION_JOB_BACKOFF_MS=5000
LOG_LEVEL=info
# Worker health endpoint port (private; never publish it).
WORKER_HEALTH_PORT=3001
# Per-account hourly send ceilings; 0 disables. Private replies follow Meta's
# documented 750/hour cap; the other two are deliberately conservative defaults.
PRIVATE_REPLY_RATE_LIMIT_PER_HOUR=750
DIRECT_MESSAGE_RATE_LIMIT_PER_HOUR=250
COMMENT_REPLY_RATE_LIMIT_PER_HOUR=250
# BUILD_COMMIT is baked into the image at build time and PRODUCTION_HEALTH_URL /
# EXPECTED_RELEASE are only used by `pnpm monitor:production`; none belongs in a
# local .env.
# Shared secret for the detailed /api/health view (x-health-token header).
# Unset locally means the detail is shown; in production unset means it is
# never shown.
HEALTH_DETAIL_TOKEN=
# DEMO_MODE=1 lets a production build boot without DATABASE_URL, REDIS_URL,
# Supabase, or META_TOKEN_ENCRYPTION_KEY. Never set it on a public deployment.
DEMO_MODE=

# e2e only (`pnpm test:e2e`). The suite refuses any non-local database or
# Supabase URL unless E2E_ALLOW_REMOTE_DB=1. VISUAL_REVIEW=1 makes some specs
# save review screenshots to /tmp.
E2E_ALLOW_REMOTE_DB=
VISUAL_REVIEW=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable
# analytics - local development and previews should stay out of the property.
GA_MEASUREMENT_ID=
