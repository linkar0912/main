APP_NAME=Linkar
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@linkar.in

# Required in production: HMAC key for login/signup rate-limit keys (min 32
# chars). Generate with a password manager or `openssl rand -hex 32`.
AUTH_SESSION_SECRET=

# Server-only Supabase Auth user UUIDs allowed into the Linkar owner console.
# Never use email addresses or expose this through a NEXT_PUBLIC_* variable.
PLATFORM_OWNER_USER_IDS=

# Production domains: APP_URL/NEXT_PUBLIC_APP_URL=https://app.linkar.in,
# ADMIN_URL=https://admin.linkar.in, and PUBLIC_SITE_URL=https://linkar.in.
# OAuth callbacks remain on app.linkar.in.

# Optional: transactional email provider key (Resend/SES) for team invitations
# and product notifications. Without it, that mail is written to the server
# log instead of being delivered. Signup confirmation and password-reset mail
# is sent by Supabase Auth instead, not through this key.
EMAIL_API_KEY=

# Plan ceiling: new automation participants served per workspace per month.

# Omit DATABASE_URL and REDIS_URL for local demo mode.
DATABASE_URL=postgresql://linkar:linkar@localhost:5432/linkar?schema=public
REDIS_URL=redis://localhost:6379

# Supabase project (Postgres + Auth) - required for any auth flow to work,
# even in local demo mode. Find these in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Business Login for Instagram
META_APP_ID=
META_APP_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
META_VERIFY_TOKEN=change-me
META_API_VERSION=v25.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages

# Facebook Login for Business (Pages). Optional - leave blank to hide the
# Facebook section in Settings. The Page access tokens are encrypted with
# META_TOKEN_ENCRYPTION_KEY by default; set FACEBOOK_TOKEN_ENCRYPTION_KEY to
# a 64-hex-char string to use a dedicated key.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/oauth/callback
FACEBOOK_VERIFY_TOKEN=change-me
FACEBOOK_API_VERSION=v25.0
FACEBOOK_SCOPES=pages_show_list,pages_manage_engagement,pages_manage_metadata,pages_read_engagement,pages_read_user_content
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Google sign-in. Optional - leave blank to hide the Google button on
# login/signup. Talks to Google directly (not through Supabase's hosted OAuth
# relay) so the consent screen shows this app's own domain instead of the
# Supabase project's; the resulting ID token still goes through Supabase
# (signInWithIdToken) to create the session.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Razorpay Subscriptions. Keep secrets server-only. Use test-mode values for
# local development and a separate live webhook secret in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR_MONTHLY_ID=
RAZORPAY_PLAN_CREATOR_ANNUAL_ID=
RAZORPAY_PLAN_GROWTH_MONTHLY_ID=
RAZORPAY_PLAN_GROWTH_ANNUAL_ID=
RAZORPAY_PLAN_AGENCY_MONTHLY_ID=
RAZORPAY_PLAN_AGENCY_ANNUAL_ID=

FOLLOW_GATED_CAMPAIGNS_ENABLED=false

# Operations tuning (sensible defaults; see README for proxy/worker guidance)
# Number of trusted reverse proxies in front of the app, used to resolve the real
# client IP from X-Forwarded-For for login rate limiting.
TRUSTED_PROXY_HOPS=0
WORKER_CONCURRENCY=5
PROVIDER_REQUEST_TIMEOUT_MS=10000
DISPATCH_LEASE_MS=30000
ADMIN_CHALLENGE_TTL_SECONDS=600
DELETION_JOB_ATTEMPTS=8
DELETION_JOB_BACKOFF_MS=5000
LOG_LEVEL=info
